{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Costco receipt transcript (SPEC §9.4) - accepted only if it adds up to the cent",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "warehouse", "items", "subtotal", "tax", "total", "tender"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "warehouse": {"type": "string", "maxLength": 80},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_number", "description", "amount", "taxable"],
        "properties": {
          "item_number": {"type": ["string", "null"], "maxLength": 20},
          "description": {"type": "string", "maxLength": 80},
          "amount": {"type": "string", "pattern": "^-?\\d+\\.\\d{2}$",
                     "description": "as printed; instant savings lines are negative"},
          "taxable": {"type": "boolean"},
          "is_instant_savings": {"type": "boolean", "default": false},
          "applies_to_item_number": {"type": ["string", "null"]}
        }
      }
    },
    "subtotal": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "tax": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "total": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "tender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_type", "card_ending"],
      "properties": {
        "card_type": {"type": ["string", "null"], "maxLength": 40},
        "card_ending": {"type": ["string", "null"], "pattern": "^\\d{4}$"}
      }
    }
  }
}
