{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/financial-adviser/sync/manifest.schema.json",
  "title": "Browsing-run manifest.json and run_report.json (SPEC §9.1)",
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "nullable_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "file_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,150}$",
      "not": {"enum": ["manifest.json", "run_report.json", "playbook_proposed.md", "guard.log"]}
    },
    "kind": {
      "enum": [
        "transactions", "statement", "order_invoice", "order_details",
        "receipt", "receipt_transcript", "payment_transactions", "selftest"
      ]
    },
    "card_id": {"anyOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, {"type": "null"}]},

    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "run_date", "files"],
      "properties": {
        "site": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "run_date": {"$ref": "#/$defs/date"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "kind", "card_id", "period_start", "period_end", "note"],
            "properties": {
              "file": {"$ref": "#/$defs/file_name"},
              "kind": {"$ref": "#/$defs/kind"},
              "card_id": {"$ref": "#/$defs/card_id"},
              "period_start": {"$ref": "#/$defs/nullable_date"},
              "period_end": {"$ref": "#/$defs/nullable_date"},
              "note": {"type": "string", "maxLength": 300}
            }
          }
        }
      }
    },

    "run_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "run_date", "collected", "gaps", "notes"],
      "properties": {
        "site": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "run_date": {"$ref": "#/$defs/date"},
        "collected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "kind", "count"],
            "properties": {
              "card_id": {"$ref": "#/$defs/card_id"},
              "kind": {"$ref": "#/$defs/kind"},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "kind", "description"],
            "properties": {
              "card_id": {"$ref": "#/$defs/card_id"},
              "kind": {"$ref": "#/$defs/kind"},
              "description": {"type": "string", "maxLength": 300}
            }
          }
        },
        "notes": {"type": "array", "items": {"type": "string", "maxLength": 500}},
        "export_formats_offered": {"type": "array", "items": {"type": "string", "maxLength": 40}},
        "tools_available": {"type": "array", "items": {"type": "string", "maxLength": 80}}
      }
    }
  }
}
