{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benefits",
    "notes"
  ],
  "properties": {
    "benefits": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "summary",
          "limits",
          "coverage",
          "evidence"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "__BENEFIT_KINDS__"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "summary": {
            "type": "string",
            "maxLength": 400
          },
          "limits": {
            "type": "string",
            "maxLength": 300
          },
          "coverage": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "primary",
              "secondary",
              null
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc",
        "page",
        "quote"
      ],
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^D[0-9]+$"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    }
  }
}
