#!/usr/bin/env python3
"""Fake `claude` CLI for tests (SPEC §18). Never calls a model.

FAKE_CLAUDE_MODE: ok | limit | limit_text | badjson | schema_invalid | missing_key | error
FAKE_CLAUDE_AUTH: authMethod reported by `claude auth status` (default claude.ai)
FAKE_CLAUDE_LOG:  if set, append {"argv", "env_keys"} as one JSON line per call
"""
import json
import os
import sys

argv = sys.argv[1:]
log = os.environ.get("FAKE_CLAUDE_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"argv": argv, "env_keys": sorted(os.environ), "cwd": os.getcwd()}) + "\n")

if argv[:2] == ["auth", "status"]:
    method = os.environ.get("FAKE_CLAUDE_AUTH", "claude.ai")
    print(json.dumps({"loggedIn": method != "none", "authMethod": method,
                      "subscriptionType": "pro"}))
    sys.exit(0)
if argv == ["--version"]:
    print("0.0.0 (Fake Claude)")
    sys.exit(0)

if "--input-format" in argv and "stream-json" in argv:
    # Driven browsing session: one assistant reply and one result per user message.
    for line in sys.stdin:
        msg = json.loads(line)
        text = msg["message"]["content"][0]["text"]
        reply = "LOGIN_NEEDED" if text.startswith("start") else f"got: {text}"
        print(json.dumps({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "name": "mcp__playwright__browser_navigate", "input": {}},
            {"type": "text", "text": reply}]}}), flush=True)
        print(json.dumps({"type": "result", "subtype": "success", "num_turns": 1,
                          "is_error": False}), flush=True)
    sys.exit(0)

mode = os.environ.get("FAKE_CLAUDE_MODE", "ok")
records = json.loads(sys.stdin.read() or "{}").get("records", [])
base = {"type": "result", "session_id": "fake", "num_turns": 2, "total_cost_usd": 0.001,
        "usage": {"input_tokens": 10, "output_tokens": 5}}

if mode == "badjson":
    print("this is not json")
    sys.exit(0)
if mode == "limit_text":
    print("Claude AI usage limit reached|1760000000")
    sys.exit(1)
if mode == "limit":
    print(json.dumps({**base, "is_error": True, "subtype": "error_during_execution",
                      "result": "5-hour limit reached ∙ resets 3pm"}))
    sys.exit(1)
if mode == "error":
    print(json.dumps({**base, "is_error": True, "subtype": "error_max_turns", "result": ""}))
    sys.exit(1)

results = [{"key": r["key"], "merchant_name": r["description"].title(),
            "category_id": "dining.coffee", "confidence": 0.9} for r in records]
if mode == "schema_invalid":
    results[0]["category_id"] = "not_a_category"
if mode == "missing_key":
    results = results[1:]
print(json.dumps({**base, "is_error": False, "subtype": "success", "result": "",
                  "structured_output": {"results": results}}))
